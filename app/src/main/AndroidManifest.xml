<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 核心闹钟权限 ========== -->
    <!-- 基础闹钟权限 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    
    <!-- Android 12+ 精确闹钟权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- Android 13+ 闹钟类应用专用：默认授予且用户不可撤销，杜绝精确闹钟权限被撤导致漏响 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <!-- ========== 唤醒和锁屏权限 ========== -->
    <!-- CPU唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- 解锁屏幕 -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    
    <!-- 悬浮窗权限（闹钟在任何应用上层显示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- ========== 后台服务权限 ========== -->
    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Android 14+ 前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    
    <!-- ========== 电池优化权限 ========== -->
    <!-- 请求忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- ========== 其他权限 ========== -->
    <!-- 存储权限（读取音乐） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- 开机自启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SleepyTuneApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepyTune"
        android:localeConfig="@xml/locale_config"
        tools:targetApi="33">
        
        <!-- 主Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SleepyTune">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 全屏闹钟提醒Activity -->
        <activity
            android:name=".ui.screen.alarm.AlarmAlertActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.example.sleepytune.alarm"
            android:theme="@style/Theme.SleepyTune.Alarm" />
        
        <!-- 闹钟触发广播接收器 - 独立进程 -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.example.sleepytune.ALARM_TRIGGERED" />
                <action android:name="com.example.sleepytune.SELF_HEAL" />
            </intent-filter>
        </receiver>
        
        <!-- 通知按钮交互广播接收器 -->
        <receiver
            android:name=".service.AlarmPlaybackReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.sleepytune.ACTION_STOP" />
                <action android:name="com.example.sleepytune.ACTION_SNOOZE" />
                <action android:name="com.example.sleepytune.ACTION_STOP_VIBRATE" />
                <action android:name="com.example.sleepytune.ACTION_PAUSE_VIBRATE" />
                <action android:name="com.example.sleepytune.ACTION_STOP_ALARM" />
                <action android:name="com.example.sleepytune.FINISH_ACTIVITY" />
            </intent-filter>
        </receiver>
        
        <!-- 前台服务 - 闹钟播放服务 -->
        <service
            android:name=".service.AlarmPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
        
        <!-- 桌面小部件 -->
        <receiver
            android:name=".widget.AlarmWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget_info" />
        </receiver>

    </application>

</manifest>
